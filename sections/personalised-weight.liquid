{{ 'section-personalised-weight.css' | asset_url | stylesheet_tag }}
{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div
  class="personalised-widget  section-{{ section.id }}-padding  color-{{ section.settings.color_scheme }} gradient  isolate {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="personalised-bg__image">
    {% if section.settings.bg_image != blank %}
      {% render 'responsive-img' with image: section.settings.bg_image , class:"mobile-hidden" %}
      {% if section.settings.bg_image_mobile != blank %}
        {% render 'responsive-img' with image: section.settings.bg_image_mobile class:"desktop-hidden" %}
      {% else %}
        {% render 'responsive-img' with image: section.settings.bg_image  class:"desktop-hidden" %}
      {% endif %}
    {% endif %}
  </div>

  <div class="personalised-widget__content">
    <div class="{{ section.settings.page_width }}">
      {%- unless section.settings.heading == blank -%}
        <div class="row">
          <div class="section--header text-center col-12 m-auto">
            <h2 class="section--title inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          </div>
        </div>
      {%- endunless -%}
      <div class="row align-items-stretch">
        <div class="col-12">
          <div class="widget__image__flex">
            <div class="widget__image-block-first">
              {% assign count = 1 %}
              {%- for block in section.blocks limit: 4 -%}
                {%- case block.type -%}
                  {%- when 'image_block' -%}
                    <div
                      class="personalised-widget__image widget__image_{{ count }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ count }};"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {% if block.settings.image != blank %}
                        {% render 'responsive-img' with image: block.settings.image %}
                      {% else %}
                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>
                    {% assign count = count | plus: 1 %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
      
            
             {% if section.settings.featured_image != blank %}
                <div class="personalised-widget__featured-image" >
             
                  {% render 'responsive-img' with image: section.settings.featured_image %}
                </div>
              {% endif %}

            <div class="widget__image-block-second">
              {% assign count = 5 %}
              {%- for block in section.blocks offset: 4 -%}
                {%- case block.type -%}
                  {%- when 'image_block' -%}
                    <div
                      class="personalised-widget__image widget__image_{{ count }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ count }};"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {% if block.settings.image != blank %}
                        {% render 'responsive-img' with image: block.settings.image %}
                      {% else %}
                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>
                    {% assign count = count | plus: 1 %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'buttons_block' %}
                <div class="personalised-widget__buttons text-center {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-cascade>
                  {% if block.settings.button_label != blank %}
                    <a href="{{ block.settings.button_link }}" class="button button--{{ block.settings.button_style }} color-{{ block.settings.color_scheme_card }}">
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}
                  {% if  block.settings.button_label_2 != blank %}
                    <a href="{{ block.settings.button_link_2 }}" class="button button--{{ block.settings.button_style_2 }} glass-container color-{{ block.settings.color_scheme_card }}">
                    
                                 <div class="glass-filter"></div>
                        <div class="glass-overlay"></div>
                        <div class="glass-specular"></div>
                         <span class="button--text">
     {{ block.settings.button_label_2 }}
                         </span>
               
                    </a>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
      <div class="row">
        
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'image_with_text' %}
                  <div class="col-lg-6 col-md-6 col-12"> 
                <div class="personalised-widget__image-text gradient color-{{ block.settings.color_scheme_card }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-cascade>
               
                  <div class="personalised-widget__image-text__content">
                    <h3 class="personalised-widget__image-text__title">
                      {{ block.settings.title }}
                    </h3>
                    <div class="personalised-widget__image-text__text rte">
                      {{ block.settings.text }}
                    </div>
                    <div class="personalised-widget__image-text__buttons">
                      {% if  block.settings.button_label != blank %}
                        <a href="{{ block.settings.button_link }}" class="button button--{{ block.settings.button_style }} color-{{ block.settings.color_scheme_card }}">
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                     
                    </div>
                  </div>
                     <div class="personalised-widget__image-text__image">
                     {% if  block.settings.button_label_2 != blank %}
                        <a href="{{ block.settings.button_link_2 }}" class="button button--{{ block.settings.button_style_2 }} color-{{ block.settings.color_scheme_card }}">
                          {{ block.settings.button_label_2 }}
                        </a>
                      {% endif %}

                    {% if block.settings.image != blank %}
                      {% render 'responsive-img' with image: block.settings.image %}
                    {% else %}
                      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                </div>
                  </div>
              {% when 'image_banner' %}
               <div class="col-lg-6 col-md-6 col-12"> 
                <div class="personalised-widget__image-banner gradient  gradient color-{{ block.settings.color_scheme_card }}  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-cascade>
                  <div class="personalised-widget__image-banner__image">
                    {% if block.settings.image != blank %}
                      {% render 'responsive-img' with image: block.settings.image %}
                    {% else %}
                      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="personalised-widget__image-banner__content">
                    <h3 class="personalised-widget__image-banner__title">
                      {{ block.settings.title }}
                    </h3>
                    <div class="personalised-widget__image-banner__text rte">
                      {{ block.settings.text }}
                    </div>
                    <div class="personalised-widget__image-banner__buttons">
                      {% if block.settings.button_label != blank %}
                        <a href="{{ block.settings.button_link }}" class="button button--{{ block.settings.button_style }} color-{{ block.settings.color_scheme_card }}">
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                      {% if block.settings.button_label_2 != blank %}
                        <a href="{{ block.settings.button_link_2 }}" class="button button--{{ block.settings.button_style_2 }} color-{{ block.settings.color_scheme_card }}">
                         
                        
                         {{ block.settings.button_label_2 }}

                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
                  </div>

            {% endcase %}
          {% endfor %}
      
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Personalised weight",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop Image"
