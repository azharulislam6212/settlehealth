                        </div>
                        <div class="tip">
                          <h4 class="tip-title inline-richtext h5">{{ tab_block.settings.tips_title_1 }}</h4>
                          <h5 class="tip-subtitle inline-richtext h6">{{ tab_block.settings.tips_sub_title_1 }}</h5>
                          <div class="tip__text rte">
                            {{ tab_block.settings.tips_text_1 }}
                          </div>
                        </div>
                      </div>

