{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
         --color-accent: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
         --color-link: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
       }


   .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.layout == 'section' %} container {% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}">
      <div class="container">
        {%- unless section.settings.heading == blank -%}
          <div class="row">
            <div class="section--header  text-{{ section.settings.heading_alignment }} col-12 m-auto">
              <h2 class="section--title inline-richtext {{ section.settings.heading_size }} ">
                {{ section.settings.heading }}
              </h2>
            </div>
          </div>
        {%- endunless -%}

        <tabbed-content>
          <div class="tablist tablist__navlist relative no-js-hidden">
            <div class="tablist__scroller " role="tablist">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'tab' -%}
                    <div class="tab__item">
                      <button
                        type="button"
                        class="tablist__tab"
                        id="tab-{{ forloop.index }}-{{ block.id }}"
                        role="tab"
                        aria-controls="panel-{{ forloop.index }}-{{ block.id }}"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                      >
                        {{ block.settings.title }}
                      </button>
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="faq-tab--wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% for tab_block in section.blocks %}
              {% if tab_block.type == 'tab' %}
                {% assign current_tab_id = tab_block.settings.tab_id %}

                <div
                  id="panel-{{  forloop.index }}-{{ tab_block.id }}"
                  role="tabpanel"
                  tabindex="0"
                  aria-labelledby="tab-{{ forloop.index }}-{{ tab_block.id }}"
                  {% unless forloop.first %}
                    hidden
                  {% endunless %}
                  {{ tab_block.shopify_attributes }}
                >
                  <div class="tab-text-header">
                    <h2 class="inline-richtext h2">{{ tab_block.settings.title }}</h2>
                  </div>

                  <div class="tab__content--flex ">
                    <div class="tab-text__content">
                      {% for content_block in section.blocks %}
                        {% if content_block.type == 'collapsible_row' %}
                          {% assign content_tab_id = content_block.settings.content_tab_id %}

                          {% if content_tab_id == current_tab_id %}
                            <collapsible-content>
                              <div
                                class="accordion {% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                                {{ content_block.shopify_attributes }}
                              >
                                <details
                                  class="disclosure"
                                  id="Details-{{ content_block.id }}-{{ section.id }}"
                                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                                    open
                                  {% endif %}
                                >
                                  <summary
                                    class="disclosure-header"
                                    id="Summary-{{ content_block.id }}-{{ section.id }}"
                                  >
                                    <h3 class="accordion__title inline-richtext h4">
                                      {{ content_block.settings.heading | escape }}
                                    </h3>
                                    <span class="disclosure__toggle">
                                      {%- if section.settings.disclosure_toggle == 'plus' -%}
                                        <svg
                                          class="plus-icon"
                                          width="16"
                                          height="16"
                                          viewBox="0 0 16 16"
                                          fill="none"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <rect x="7" y="16" width="16" height="2" transform="rotate(-90 7 16)" fill="currentColor"/>
                                          <rect y="9" width="2" height="16" transform="rotate(-90 0 9)" fill="currentColor"/>
                                        </svg>

                                        <svg
                                          class="minus-icon"
                                          width="16"
                                          height="2"
                                          viewBox="0 0 16 2"
                                          fill="none"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <rect y="2" width="2" height="16" transform="rotate(-90 0 2)" fill="currentColor"/>
                                        </svg>

                                      {%- else -%}
                                        <svg
                                          class="icon icon-caret"
                                          width="12"
                                          height="8"
                                          viewBox="0 0 12 8"
                                          fill="none"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <path d="M9.59999 0.5L5.49997 4.60001L1.4 0.500006L0 1.90001L5.49997 7.50001L11.1 2L9.59999 0.5Z" fill="#0A0A0A"/>
                                        </svg>
                                      {%- endif -%}
                                    </span>
                                  </summary>
                                  <div class="disclosure__panel has-motion">
                                    <div
                                      class="accordion__content disclosure__content rte"
                                      id="CollapsibleAccordion-{{ content_block.id }}-{{ section.id }}"
                                      role="region"
                                      aria-labelledby="Summary-{{ content_block.id }}-{{ section.id }}"
                                    >
                                      {{ content_block.settings.row_content }}
                                    </div>
                                  </div>
                                </details>
                              </div>
                            </collapsible-content>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>

                    <div class="tab__content__tips">
