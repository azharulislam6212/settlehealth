{{ 'welcome-modal.css' | asset_url | stylesheet_tag }}
<div id="age-modal" class="modal-overlay">
  <div class="modal-content color-{{ section.settings.color_scheme }} gradient">
    <button id="close-btn" class="close-btn">×</button>
    <div class="modal-header">
      <a href="{{ section.settings.image_link }}">
        {% if section.settings.image != blank %}
          {% render 'icon-img' with image: section.settings.image, class: "modal-logo" %}
        {% endif %}
      </a>
    </div>
    <div class="modal-body">
      <h2>{{ section.settings.title }}</h2>
      <div class="modal-text">
        {{ section.settings.text }}
      </div>
      <div class="btn-container">
        <a href="{{ section.settings.button_link }}" id="enter-btn" class="gv-btn button button--primary">
          {{- section.settings.button_label }}
          <svg width="34" height="13" viewBox="0 0 34 13" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M25.9453 0C27.5039 1.69922 28.8516 2.99414 29.9883 3.88477C31.125 4.76367 32.1973 5.41992 33.2051 5.85352V6.64453C32.0449 7.20703 30.9199 7.92773 29.8301 8.80664C28.7402 9.67383 27.4394 10.9512 25.9277 12.6387H24.5742C25.6758 10.2832 26.8301 8.47266 28.0371 7.20703H-5.72205e-06V5.43164H28.0371C27.1465 4.30664 26.5254 3.46875 26.1738 2.91797C25.8223 2.35547 25.3008 1.38281 24.6094 0H25.9453Z" fill="white"/>
          </svg>
        </a>
        <a href="{{ section.settings.button_link_2 }}" class="gv-modal-alt button--link">
          {{- section.settings.button_label_2 -}}
        </a>
      </div>
       <div class="icon-block__bar">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'icon_block' -%}
                <div
                  class="icon-block-item"
                  {{ block.shopify_attributes }}
                  
                >
                  {% if block.settings.image %}
                    <div class="icon-block__icon">
                      {% render "responsive-img" with image: block.settings.image %}
                    </div>
                  {% endif %}

                  <div class="icon-block__content">
                    {% if block.settings.title != blank %}
                      <h3 class="icon-block__title">{{ block.settings.title }}</h3>
                    {% endif %}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <div class="trusted-bar">

       

