</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('age-modal');
    const enterBtn = document.getElementById('enter-btn');
    const closeBtn = document.getElementById('close-btn');
    const switchProviderLink = document.querySelector('.switch-provider');
    const pharmacyUrl = '{{ section.settings.button_link }}';
    // Prevent scrolling
    document.body.classList.add('modal-open');
    function redirectToPharmacy() {
      window.location.href = pharmacyUrl;
    }
    enterBtn.addEventListener('click', function (e) {
      e.preventDefault();
      redirectToPharmacy();
    });
    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      redirectToPharmacy();
    });
    if (switchProviderLink) {
      switchProviderLink.addEventListener('click', function (e) {
        e.preventDefault();
        redirectToPharmacy();
      });
    }
    modal.addEventListener('click', function (e) {
      if (e.target === modal) {
        redirectToPharmacy();
      }
    });
    const modalLogo = document.querySelector('.modal-logo');
    modalLogo.addEventListener('click', function (e) {
      e.preventDefault();
      redirectToPharmacy();
    });
    modalLogo.style.cursor = 'pointer';
    // Prevent keyboard scrolling (arrow keys, page up/down, space)
    document.addEventListener('keydown', function (e) {
      // Prevent scrolling with arrow keys, page up/down, space, home, end
      if ([32, 33, 34, 35, 36, 37, 38, 39, 40].indexOf(e.keyCode) > -1) {
        e.preventDefault();
      }
    });
    document.addEventListener(
      'wheel',
      function (e) {
        e.preventDefault();
      },
      {
        passive: false,
      }
    );
    document.addEventListener(
      'touchmove',
      function (e) {
        e.preventDefault();
      },
      {
        passive: false,
      }
    );
  });
</script>

{% schema %}
{
  "name": "Welcome Modal",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Url"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Get started",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Let’s get you started on the right path. Are you new to weight loss programmes, or looking to switch treatments?</p>",
      "label": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "trusted_by",
      "default": "Trusted by over 100,000 patients",
      "label": "Trusted by"
    },
    {
      "type": "header",
      "content": "Weghtloss programmes"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Get started",
      "label": "Button Lebel"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Url"
    },
    {
      "type": "header",
      "content": "Switch treatments"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "Get started",
      "label": "Button Lebel"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button Url"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "t:sections.multicolumn.blocks.column.settings.title.default",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Welcome Modal"
    }
  ]
}
{% endschema %}
