
{% style %}
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width:768px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

        .medication-comparison-section {
      background: var(--background);
    }
    .medication-comparison-section .section-title {
      text-align: center;
      margin-bottom: 50px;
    }
    .medication-comparison-section .section-title h2 {
      font-size: 36px;
      font-style: normal;
      font-weight: 400;
      margin-bottom: 15px;
      color: var(--title-color);
    }

    .medication-comparison-section .section-title em {
      color: var(--accent-color);
      font-style:normal;
    }
    .medication-comparison-section .section-title p {
      font-size: 16px;
      line-height: 1.6;
         color: var(--text-color);
      max-width: 700px;
      margin: 0 auto;
    }
    .medication-comparison-section .comparison-table-wrapper {
      max-width: 1008px;
      margin: 0 auto;
    }
    .medication-comparison-section .comparison-table {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #cee2e9;
    }
    .medication-comparison-section .table-header {
      background: #210847;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
    }
    .medication-comparison-section .header-cell {
      padding: 20px 25px;
      color: white;
      display: flex;
      align-items: center;
      gap: 12px;
      border-right: 1px solid #4e3c6d;
      border-bottom: 1px solid #cee2e9;
    }
    .medication-comparison-section .header-cell:last-child {
      border-right: none;
    }
    .medication-comparison-section .header-cell h3 {
      font-size: 18px;
      font-weight: 500;
      margin: 0;
    }
    .medication-comparison-section .table-body {
      display: contents;
    }
    .medication-comparison-section .table-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
    }
    .medication-comparison-section .table-row:nth-child(odd) {
      background: transparent;
    }
    .medication-comparison-section .table-row:nth-child(even) {
      background: #fff;
    }
    .medication-comparison-section .row-header {
      padding: 18px 25px;
      border-right: 1px solid #cee2e9;
      border-bottom: 1px solid #cee2e9;
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      color: var(--text-color);
    }
    .medication-comparison-section .table-cell {
      padding: 18px 25px;
      border-right: 1px solid #cee2e9;
      border-bottom: 1px solid #cee2e9;
      display: flex;
      align-items: center;
      color: var(--text-color);
    }
    .medication-comparison-section .table-cell:last-child {
      border-right: none;
    }
    .medication-comparison-section .table-row:last-child .table-cell,
    .medication-comparison-section .table-row:last-child .row-header {
      border-bottom: none;
    }

    .svg-icon, .mobile-row-icon{
        line-height:0;
        width:20px;
        height:20px
    }

    .mobile-row-label{
        display:flex;
        align-items:center;
        gap: 5px;
    }
    @media only screen and (max-width: 991px) {
    
      .medication-comparison-section .section-title h2 {
        font-size: 30px;
        text-align: left;
      }
      .medication-comparison-section .section-title {
        margin-bottom: 30px;
      }
      .medication-comparison-section .comparison-table {
        display: none !important;
      }
      .medication-comparison-section .mobile-tables {
        display: block !important;
      }
      .medication-comparison-section .mobile-table {
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 24px;
        border: 1px solid #cee2e9;
      }
      .medication-comparison-section .mobile-table:last-child {
        margin-bottom: 0;
      }
      .medication-comparison-section .mobile-header {
        background: #210847;
        padding: 20px 18px;
        color: white;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .medication-comparison-section .mobile-header h3 {
        font-size: 18px;
        font-weight: 500;
        margin: 0;
      }
      .medication-comparison-section .mobile-row {
        display: flex;
        padding: 20px 18px;
        align-items: center;
        border-bottom: 1px solid #cee2e9;
      }
      .medication-comparison-section .mobile-row:last-child {
        border-bottom: none;
      }
      .medication-comparison-section .mobile-row:nth-child(odd) {
        background: #fff;
      }
      .medication-comparison-section .mobile-row-icon {
        display: inline-block;
        padding-right: 7px;
        position: relative;
        top: 2px;
      }
      .medication-comparison-section .mobile-row-content {
        flex: 1;
      }
      .medication-comparison-section .mobile-row-label {
        font-weight: 500;
        margin-bottom: 7px;
        color: #210847;
      }
      .medication-comparison-section .mobile-row-value {
        color: #210847;
        font-size: 16px;
        font-weight: 400;
      }
      .medication-comparison-section .section-title p {
        font-size: 16px;
        text-align: left;
      }
    }
    @media only screen and (min-width: 992px) {
      .medication-comparison-section .mobile-tables {
        display: none !important;
      }
    }
{% endstyle %}

