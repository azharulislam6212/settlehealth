{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "<em>Wegovy vs Mounjaro</em> at a glance",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "default": "Our clinical team has developed a safe, easy-to-follow switching process that’s available immediately.",
      "label": "Text"
    },
        {
      "type": "inline_richtext",
      "id": "comparison_title_1",
      "default": "Wegovy",
      "label": "Comparison Title 1"
    },
            {
      "type": "inline_richtext",
      "id": "comparison_title_2",
      "default": "Mounjaro",
      "label": "Comparison Title 2"
    },
    {
      "type": "color_background",
      "id": "sec_background",
      "label": "Background",
      "default": "#f2f9fc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#a15cff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#83EDFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#210847"
    },
     {
      "type": "header",
      "content": "Calculator Box Color"
    },
        {
      "type": "color",
      "id": "clcr_bg_color",
      "label": "Text Color",
      "default": "#210847"
