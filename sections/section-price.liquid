{% style %}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

    }
  
    .nb-pricing-wrapper {
      background: var(--background);

    }
    .nb-pricing-header {
      text-align: center;
      margin-bottom: 40px;
    }
    .nb-pricing-header h2 {
     color: var(--title-color);
      font-size: 36px;
      font-weight: 400;
      line-height: 1.2;
      margin: 0 0 25px 0;
    }
    .nb-pricing-header h2 span {
       color: var(--accent-color);
    }
    .nb-pricing-header p {
       color: var(--text-color);
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      margin: 0 0 30px 0;
    }
    .nb-pricing-header .gv-btn {
      margin-bottom: 0;
    }
    .nb-pricing-grid {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin-top: 50px;
    }
    .nb-pricing-wegovy-only {
      min-width: 400px;
    }
    .nb-pricing-column {
      background: transparent;
    }
    .nb-pricing-column-content {
      background: white;
      border-radius: 16px;
      overflow: hidden;
    }
    .nb-pricing-column-header {
      background: var(--title-bg-color);
      color: var(--title-color);
      text-align: center;
      padding: 20px;
    }
    .nb-pricing-column-header i {
      color: var(--accent-color);
      font-size: 20px;
      margin-right: 8px;
      display: none;
    }
    .nb-pricing-column-title {
      font-size: 18px;
      font-weight: 500;
      margin: 0;
      text-align: left;
      padding-left: 10px;
    }
    .nb-pricing-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 30px;
      border-bottom: 1px solid #c8dce3;
    }
    .nb-pricing-row:last-child {
      border-bottom: none;
    }
    .nb-pricing-dosage {
      color: var(--text-color);
      font-size: 16px;
      font-weight: 500;
      width: 60px;
    }
    .nb-pricing-label {
       color: var(--text-color);
      opacity: 0.4;
      font-size: 16px;
      font-weight: 400;
    }
    .nb-pricing-price {
       color: var(--text-color);
      font-size: 16px;
      font-weight: 500;
      width: 60px;
      text-align: right;
    }
    .nb-pricing-disclaimer {
      text-align: center;
      margin-top: 15px;
      color: #7c7979;
      font-size: 14px;
      font-weight: 400;
      opacity: 1;
      max-width: 100%;
      padding-top: 16px;
    }
    .nb-pricing-cta {
      text-align: center;
      margin-top: 40px;
    }
    @media (max-width: 768px) {
      .nb-pricing-header h2 {
        text-align: center;
        max-width: 390px;
        margin: 0 auto 10px;
      }
      .nb-pricing-header p {
        text-align: center;
      }
      .nb-pricing-header {
        text-align: center;
        margin-bottom: 30px;
      }
      .nb-pricing-grid {
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
      }
      .nb-pricing-wegovy-only {
        max-width: 100%;
        min-width: 0;
        width: 100%;
      }
      .nb-pricing-row {
        padding: 15px 20px;
      }
      .nb-pricing-column-header {
        padding: 15px;
      }
      .nb-pricing-column-title {
        padding-left: 5px;
      }
    }
{% endstyle %}

<section
  class="nb-pricing-wrapper section-{{ section.id }}-padding"
  style="
    --background: {{ section.settings.sec_background }};
    --accent-color:{{ section.settings.accent_color}};
    --title-bg-color:{{ section.settings.title_bg_color}};
    --title-color:{{ section.settings.title_color}};
    --text-color:{{ section.settings.text_color}};
    --button-bg-color:{{ section.settings.button_bg}};
    --button-text-color:{{ section.settings.button_text_color}};
  "
>
  <div class="gv-section-inner">
    <div class="nb-pricing-container">
      <div class="nb-pricing-grid">
        <!-- Wegovy Column - Centered -->
        <div class="nb-pricing-column nb-pricing-wegovy-only">
          <div class="nb-pricing-column-content">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'title' -%}
                  <div class="nb-pricing-column-header">
                    <h3 class="nb-pricing-column-title">{{ block.settings.title }}</h3>
                  </div>

                {%- when 'item' -%}
                  <div class="nb-pricing-row">
                    <div class="nb-pricing-dosage">{{ block.settings.dosage_title }}</div>
                    <div class="nb-pricing-label">{{ block.settings.dosage_label }}</div>
                    <div class="nb-pricing-price">{{ block.settings.dosage_price }}</div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'button' -%}
            <div class="nb-pricing-cta">
              <a href="{{ block.settings.button_link }}" class="gv-btn">{{ block.settings.button_label }}</a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Section price",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_background",
      "id": "sec_background",
      "label": "Background",
      "default": "#f2f9fc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#a15cff"
    },
    {
      "type": "color",
      "id": "title_bg_color",
      "label": "Title Bg color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#83EDFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#210847"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 26
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Wegovy",
          "label": "Title"
        }
      ]
    },
    {
      "type": "item",
      "name": "Item Block",
      "settings": [
        {
          "type": "text",
          "id": "dosage_title",
          "default": "0.25mg",
          "label": "Dosage Title"
        },
        {
          "type": "text",
          "id": "dosage_label",
          "default": "Starting dose",
          "label": "Dosage label"
        },
        {
          "type": "text",
          "id": "dosage_price",
          "default": "£85",
          "label": "Dosage price"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Start your switch",
          "label": "Button Lebel"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section price",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
