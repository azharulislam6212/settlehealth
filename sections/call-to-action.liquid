{{ 'section-call-to-action.css' | asset_url | stylesheet_tag }}
{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}
<div class="{{ section.settings.page_width }}">
  <div
    class="call-to-action is-hidden section-{{ section.id }}-padding  color-{{ section.settings.color_scheme }} gradient  isolate {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
    data-time="{{ section.settings.hide_duration }}"
  >
    <div class="call-to-action__flex">
      <div class="call-to-action__text">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="button--action">{{ section.settings.button_label }}</a>
        {% endif %}

        {{- section.settings.text -}}
      </div>

      <div class="call-to-action__actions">
        {% if section.settings.check_button_label != blank %}
          <a href="{{ section.settings.check_button_link }}" class="button--precheck">
            {{- section.settings.check_button_label -}}
          </a>
        {% endif %}

        <button type="button" class="dismiss-button link-underline">Dismiss</button>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.querySelector('.call-to-action');
    const dismissBtn = document.querySelector('.dismiss-button');

    if (!wrapper || !dismissBtn) return;

    const minutes = parseInt(wrapper.dataset.time) || 5;
    const HIDE_DURATION = minutes * 60 * 1000;
    const hideUntil = localStorage.getItem('dismissHideUntil');

    // যদি ৫ মিনিট শেষ হয়ে যায় → show করবে
    if (!hideUntil || Date.now() > parseInt(hideUntil)) {
      wrapper.classList.remove('is-hidden');
    }

    dismissBtn.addEventListener('click', function () {
      const expireTime = Date.now() + HIDE_DURATION;
      localStorage.setItem('dismissHideUntil', expireTime);

      wrapper.classList.add('is-hidden');
    });
  });
</script>

{% schema %}
{
  "name": "call to action",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container-fluid",
      "label": "Layout Width"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multirow.blocks.row.settings.button_label.default",
      "label": "t:sections.multirow.blocks.row.settings.button_label.label",
      "info": "t:sections.multirow.blocks.row.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multirow.blocks.row.settings.button_link.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.multicolumn.blocks.column.settings.text.default",
      "label": "t:sections.multicolumn.blocks.column.settings.text.label"
    },
    {
      "type": "header",
      "content": "Pre check Button"
    },
    {
      "type": "text",
      "id": "check_button_label",
      "default": "t:sections.multirow.blocks.row.settings.button_label.default",
      "label": "t:sections.multirow.blocks.row.settings.button_label.label",
      "info": "t:sections.multirow.blocks.row.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "check_button_link",
      "label": "t:sections.multirow.blocks.row.settings.button_link.label"
    },
    {
      "type": "range",
      "id": "hide_duration",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "min",
      "label": "Hide Duration",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Call to action",
      "category": "Text"
    }
  ]
}
{% endschema %}