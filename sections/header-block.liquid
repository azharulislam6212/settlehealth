
 {% style %}

   .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }


     .header-block-container {
      background-color: var(--background);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }
    .header-block-container .content-box {
      background-color: white;
      border-radius: 16px;
      padding: 10px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .header-block-container .chequp-logo {
      max-width: 85px;
      height: auto;
      display: block;
    }
    .header-block-container .cta-button {
      flex-shrink: 0;
    }
    .header-block-container .cta-button .gv-btn {
      margin-bottom: 0px;
    }
    @media only screen and (max-width: 768px) {
      .header-block-container .content-box {
        gap: 20px;
        padding: 10px 17px;
      }
    }
 {% endstyle %}
  <div class="header-block-container   section-{{ section.id }}-padding" style="
    --background: {{ section.settings.sec_background }};
    --button-bg-color:{{ section.settings.button_bg}};
    --button-text-color:{{ section.settings.button_text_color}};
    ">
    <div class="gv-section-inner">
      <div class="content-box">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'image_block' -%}
              <a href="{{ block.settings.image_link }}">
                {% if block.settings.image != blank %}
                  {% render 'icon-img' with image: block.settings.image %}
                {% endif %}
              </a>

            {%- when 'button' -%}
              <div class="cta-button">
                <a href="{{ block.settings.button_link }}" class="gv-btn">{{ block.settings.button_label }}</a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>


{% schema %}
{
  "name": "Header Blocks",
  "class": "header-block-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
            {
      "type": "color_background",
      "id": "sec_background",
      "label": "Background",
      "default": "#210847"
    },
       {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#83EDFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#210847"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Logo Block",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image Url"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Get started",
          "label": "Button Lebel"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header Blocks",
      "blocks": [
        {
          "type": "image_block"
        }
      ]
    }
  ]
}
{% endschema %}
