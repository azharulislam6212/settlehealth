{% style %}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

    }

    .nb-get-started-wrapper {
      background: var(--background);
    }

    .nb-get-started-wrapper  .placeholder-svg{
           stroke: var(--title-color);
           background-color: #dedede;
    }
    .nb-get-started-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 50px;
    }
    .nb-get-started-title-content {
      flex: 1;
    }
    .nb-get-started-wrapper h2 {
      color: var(--title-color);
      font-size: 36px;
      font-weight: 400;
      margin: 0;
      line-height: 1.2;
    }
    .nb-get-started-wrapper h2 span ,    .nb-get-started-wrapper h2 em {
      color: var(--accent-color);
      font-style:normal;
    }
    .nb-get-started-cta {
      margin-left: 20px;
      flex-shrink: 0;
      position: relative;
      top: 5px;
    }
    .nb-get-started-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 17px;
    }
    .nb-get-started-row-2 {
      grid-column: 1 / 3;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
    }
    .nb-step-block {
      border-radius: 20px;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      color: var(--text-color);
      background: var(--block-bg);
      position: relative;
      overflow: hidden;
      min-height: 250px;
    }
    .nb-step-block.step-02 {
      background: #a15cff;
    }
    .nb-step-block.step-03 {
      background: #a48af9;
      color: #210847;
    }
    .nb-image-block {
      border-radius: 20px;
      overflow: hidden;
      position: relative;
    }
    .nb-image-block img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .nb-step-number {
      font-size: 48px;
      font-weight: 400;
      margin-bottom: 30px;
    }
    .nb-step-title {
      font-size: 30px;
      font-weight: 500;
      margin-bottom: 15px;
      line-height: 1.2;
      max-width: 500px;
    }
    .nb-step-description {
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      margin: 0;
    }
    .nb-get-started-cta .gv-btn {
      margin: 0;
    }
    @media (max-width: 1024px) {

      .nb-get-started-header {
        flex-direction: column;
        margin-bottom: 30px;
      }
      .nb-get-started-wrapper h2 {
        font-size: 30px;
        margin-bottom: 10px;
      }
      .nb-get-started-cta {
        margin-left: 0;
        align-self: flex-start;
      }
      .nb-get-started-grid {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
        gap: 10px;
      }
      .nb-get-started-row-2 {
        grid-column: 1;
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .nb-step-block {
        padding: 25px 25px 30px;
        min-height: 150px;
      }
      .nb-image-block {
        display: none;
      }
      .nb-step-number {
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 12px;
        background: rgba(255, 255, 255, 0.2);
        width: 27px;
        height: 27px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .nb-step-title {
        font-size: 24px;
        margin-bottom: 10px;
      }
      .nb-step-description {
        font-size: 14px;
      }
    }
{% endstyle %}
<section
  class="nb-get-started-wrapper section-{{ section.id }}-padding"
  style="
    --background: {{ section.settings.sec_background }};
    --accent-color:{{ section.settings.accent_color}};
    --title-color:{{ section.settings.title_color}};
    --text-color:{{ section.settings.text_color}};
    --button-bg-color:{{ section.settings.button_bg}};
    --button-text-color:{{ section.settings.button_text_color}};
  "
>
  <div class="gvlp-section-inner">
    <div class="nb-get-started-container">
      <div class="nb-get-started-header">
        <div class="nb-get-started-title-content">
          <h2>{{ section.settings.title }}</h2>
        </div>

        {% if section.settings.button_label != blank %}
          <div class="nb-get-started-cta">
            <a href="{{ section.settings.button_link }}" class="gv-btn">{{ section.settings.button_label }}</a>
          </div>
        {% endif %}
      </div>
      <div class="nb-get-started-grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'step_block' -%}
              <div class="nb-step-block step-01" style="--block-bg: {{ block.settings.block_background }} ; --text-color:{{ block.settings.text_color}}">
                <div class="nb-step-number">{{ block.settings.step_number }}</div>
                <h3 class="nb-step-title">{{ block.settings.title }}</h3>
                <p class="nb-step-description">{{ block.settings.text }}</p>
              </div>

            {%- when 'image' -%}
              {% if block.settings.image != blank %}
                <div class="nb-image-block">
                  {% render 'responsive-img' with image: block.settings.image %}
                </div>

              {% else %}
                <div class="nb-image-block">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}

        <!-- Bottom Row: 3 blocks (1/3 each) -->
        <div class="nb-get-started-row-2">
             {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'step_block_Bottom' -%}
            <div class="nb-step-block step-02" style="--block-bg: {{ block.settings.block_background }} ; --text-color:{{ block.settings.text_color}}">
               <div class="nb-step-number">{{ block.settings.step_number }}</div>
                <h3 class="nb-step-title">{{ block.settings.title }}</h3>
                <p class="nb-step-description">{{ block.settings.text }}</p>
            </div>
                {%- when 'image_bottom' -%}
                {% if block.settings.image != blank %}
                <div class="nb-image-block">
                  {% render 'responsive-img' with image: block.settings.image %}
                </div>

              {% else %}
                <div class="nb-image-block">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
               {%- endcase -%}
        {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Get Started",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Get started in just <em>three simple steps</em>",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Start your switch",
      "label": "Button Lebel"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Url"
    },
    {
      "type": "color_background",
      "id": "sec_background",
      "label": "Background",
      "default": "#e3f2f8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#683cf5"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#210847"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#83EDFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#210847"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "step_block",
      "name": "Step Block (Top)",
            "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "default": "01",
          "label": "Step number"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Tell us about your treatment",
          "label": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Complete a short medical questionnaire - it only takes a couple of minutes. We’ll ask about your current medication and dose so we can continue your weight loss journey safely.",
          "label": "Text"
        },
        {
          "type": "color_background",
          "id": "block_background",
          "label": "Background",
          "default": "#210847"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image Block (Top)",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "step_block_Bottom",
      "name": "Step Block (Bottom)",
            "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "default": "02",
          "label": "Step number"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Tell us about your treatment",
          "label": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Complete a short medical questionnaire - it only takes a couple of minutes. We’ll ask about your current medication and dose so we can continue your weight loss journey safely.",
          "label": "Text"
        },
        {
          "type": "color_background",
          "id": "block_background",
          "label": "Background",
          "default": "#210847"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "image_bottom",
      "name": "Image Block (Bottom)",
            "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Get Started",
      "blocks": [
        {
          "type": "step_block"
        }
      ]
    }
  ]
}
{% endschema %}
