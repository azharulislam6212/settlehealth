{{ 'section-multicolumns.css' | asset_url | stylesheet_tag }}
{%- style -%}

    .section-{{ section.id }}-padding {
         --color-accent: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
         --color-link: {{ section.settings.color_accent.red }},{{ section.settings.color_accent.green }},{{ section.settings.color_accent.blue }};
       }


    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    @media screen and (min-width: 992px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_tab }}px;
        padding-bottom: {{ section.settings.padding_bottom_tab }}px;
      }
  }

    @media screen and (min-width: 1024px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}
<div
  id="{{ section.settings.them_section_id |  default:"multicolumns-section" }}"
  class="multicolumns-section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="{{ section.settings.page_width }}">

      <div class="multicolumns-wrapper">

       
    {%- unless section.settings.heading == blank -%}
      <div class="row">
        <div class="section--header text-{{ section.settings.alignment }} col-12 m-auto">
          <h2 class="section--title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
          {% if section.settings.text != blank %}
            <div class="section--text">{{ section.settings.text }}</div>
          {% endif %}
        </div>
      </div>
    {%- endunless -%}

   
 
        <div class="column-block row  row-cols-1 row-cols-md-3">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'column' -%}
                <div class="column-item  col" {{ block.shopify_attributes }}>
                  <div class="column-block {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"     {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}>

                   

                    <div class="column-block__image">
                      {% if block.settings.image != blank %}
                        {% render 'responsive-img' with image: block.settings.image %}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>

                    <div class="column-block__content">
                  
                      {% if block.settings.title != blank %}
                        <h2 class="column-block__title">{{ block.settings.title }}</h2>
                      {% endif %}
                   
                      {% if block.settings.text != blank %}
                        <p class="column-block__text rte">{{ block.settings.text }}</p>
                      {% endif %}

                    
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

         
         
     
  
       </div>
  </div>
</div>
{%- if section.settings.enable_divider -%}
   <div class="section-divider"></div>
{%- endif -%}
{% schema %}
{
  "name": "Multicolumns custom",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
                  {
      "type": "checkbox",
      "id": "enable_divider",
      "default": false,
      "label": "Enable divider"
    },
    {
      "type": "select",
      "id": "page_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Full Width"
        }
      ],
      "default": "container-fluid",
      "label": "Layout Width"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Section Heading",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.image-with-text.blocks.text.settings.text.default",
      "label": "t:sections.image-with-text.blocks.text.settings.text.label"
    },
       {
      "type": "text_alignment",
      "id": "alignment",
      "default":  "left",
      "label": "Alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "Card Color",
      "default": "scheme-4"
    },
        {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#CCF9AB"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_top_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Tab",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom_tab",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Tab",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 56
    },
    {
      "type": "text",
      "id": "them_section_id",
      "label": "Section Id"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Experts in treating menopause"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Personalised care designed around you. Access a world of data and analytics so you can manage your health like never before"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumns custom",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
