{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- style -%}
  
  
     .section-{{ section.id }}-padding {
       padding-top: {{ section.settings.padding_top_mobile }}px;
       padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
     }
     @media screen and (min-width: 992px) {
       .section-{{ section.id }}-padding {
         padding-top: {{ section.settings.padding_top_tab }}px;
         padding-bottom: {{ section.settings.padding_bottom_tab }}px;
       }
   }

     @media screen and (min-width: 1024px) {
       .section-{{ section.id }}-padding {
         padding-top: {{ section.settings.padding_top }}px;
         padding-bottom: {{ section.settings.padding_bottom }}px;
       }
     }


{%- endstyle -%}

<article class="article-template section-{{ section.id }}-padding">
  <div class="container">
    <div class="article__blog-flex">
      <div class="side-bar__blog">

      

      <div class="table-of-content__wrapper"> 
        <h3 class="table-of-content">Table of contents</h3>



         {% assign table_of_contents  = article.metafields.custom.table_of_contents.value %}


        <ul class="content-list">
        {%- for table_of_content in table_of_contents -%}
            <li><a href="#{{ table_of_content |  handleize }}">{{ table_of_content }}</a></li>
        {%- endfor -%}
        </ul>

        </div>


        <div class="divider-line-sidebar"> 
          <span class="visually-hidden">line</span> </div>


               {% assign contributors  = article.metafields.custom.contributors.value %}
         
          {%- if contributors != blank -%}
 
        
          <div class="contributors">
            <h3 class="contributors__heading">Contributors</h3>
            <ul class="contributors__list">
              {% for contributor in contributors %}
 
                <li class="contributors__item">
                  {% if contributor.image != blank %}
                      <div class="contributor-img">
                        {% render "responsive-img" with image: contributor.image %}
                      </div>
                    {% endif %}

                      <div class="contributor__content">
                          {% if contributor.name != blank  %}
                          <h4 class="contributor-name">{{ contributor.name}}</h4>
                        {% endif %} 
                          {% if contributor.designation != blank %}
                          <p class="contributor-designation">{{ contributor.designation }}</p>
                        {% endif %} 
                      </div>

                   
                </li>
              {% endfor %}
            </ul>
            </div>

                   <div class="divider-line-sidebar"> 
          <span class="visually-hidden">line</span> </div>


{%- endif -%}




                           {%- form 'customer', id: 'ContactBlog', class: 'sidebar__newsletter_form' -%}
                                <input type="hidden" name="contact[tags]" value="newsletter">
                                

                                  <div class="sidebar-form__fields">

                                                                   


                                    <label class="sidebar-form__lebel" for="NewsletterForm--{{ section.id }}">
                                      Subscribe to our newsletter
                                    </label>

                                    
                                    <input
                                      id="NewsletterForm--{{ section.id }}"
                                      type="email"
                                      name="contact[email]"
                                      class="sidebar-form__input"
                                      value="{{ form.email }}"
                                      aria-required="true"
                                      autocorrect="off"
                                      autocapitalize="off"
                                      autocomplete="email"
                                      {% if form.errors %}
                                        autofocus
                                        aria-invalid="true"
                                        aria-describedby="ContactFooter-error"
                                      {% elsif form.posted_successfully? %}
                                        aria-describedby="ContactFooter-success"
                                      {% endif %}
                                      placeholder="Enter your email"
                                      required
                                    >

                                       
                                    <button
                                      type="submit"
                                      class="sidebar-newsletter-button"
                                      name="commit"
                                      id="Subscribe"
                                      aria-label="{{ 'newsletter.button_label' | t }}"
                                    >
                                      <span>Subscribe</span>
                                 
                                    </button>
                                  </div>
                                  {%- if form.errors -%}
                                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                                      <span class="svg-wrapper">
                                        {{- 'icon-error.svg' | inline_asset_content -}}
                                      </span>
                                      {{- form.errors.translated_fields.email | capitalize }}
                                      {{ form.errors.messages.email -}}
                                    </small>
                                  {%- endif -%}
                                
                                {%- if form.posted_successfully? -%}
                                  <h3
                                    class="newsletter-form__message newsletter-form__message--success form__message"
                                    id="ContactFooter-success"
                                    tabindex="-1"
                                    autofocus
                                  >
                                    <span class="svg-wrapper">
                                      {{- 'icon-success.svg' | inline_asset_content -}}
                                    </span>
                                    {{- 'newsletter.success' | t }}
                                  </h3>
                                {%- endif -%}
                              {%- endform -%}



            <div class="divider-line-sidebar"> 
          <span class="visually-hidden">line</span> </div>

          <ul class="social-article-list">
            <li>
              <button type="button" class="article-link"  data-article-url="{{ article.url }}">
