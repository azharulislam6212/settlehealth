{% style %}
 

 @font-face {
    font-family: 'F37 Ginger';
    src: url("{{'F37Ginger-Bold.woff2' | asset_url }}") format('woff2'),
        url("{{'F37Ginger-Bold.woff' |       asset_url }}") form at('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'F37 Ginger';
    src: url("{{'F37Ginger-Regular.woff2' | asset_url}}") format('woff2'),
        url("{{'F37Ginger-Regular.woff' | asset_url }}") format('woff');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'F37 Ginger';
    src: url("{{'F37Ginger-Light.woff2' | asset_url}}") format('woff2'),
        url("{{'F37Ginger-Light.woff' | asset_url }}") format('woff');
    font-weight: 200;
    font-style: normal;
    font-display: swap;
}
@font-face {
    font-family: 'F37 Ginger';
    src: url("{{'F37Ginger-Thin.woff2' | asset_url }}") format('woff2'),
        url("{{'F37Ginger-Thin.woff' | asset_url }}") format('woff');
    font-weight: 100;
    font-style: normal;
    font-display: swap;
}


 
@font-face {
    font-family: 'ABC Diatype Rounded Unlicensed Trial';
    src: url({{'ABCDiatypeRounded-Medium.woff2' | asset_url}}) format('woff2'),
        url({{'ABCDiatypeRounded-Medium.woff' | asset_url}}) format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'ABC Diatype Rounded Unlicensed Trial';
    src: url({{'ABCDiatypeRounded-MediumItalic.woff2' | asset_url}}) format('woff2'),
        url({{'ABCDiatypeRounded-MediumItalic.woff' | asset_url}}) format('woff');
    font-weight: 500;
    font-style: italic;
    font-display: swap;
}

{% endstyle %}
