        "terms_conditions_dKMfLF": {
          "type": "terms_conditions",
          "settings": {
            "terms_conditions": "<p>Actual price will depend on pay as you go or subscription plan purchase, promotional offers and discount codes are available to input at checkout. Requires an online consultation with a clinician who will determine if treatment is appropriate.<\/p><p><br\/>*Jastreboff, A.M., Aronne, L.J., Ahmad, N.J., Wharton, S., Connery, L., Alves, B., Kiyosue, A., Zhang, S., Liu, B., Bunck, M.C. and Stefanski, A. (2022) ‘Tirzepatide once weekly for the treatment of obesity’, New England Journal of Medicine, 387(3), pp. 205–216. doi:10.1056\/NEJMoa2206038. In the <a href=\"https:\/\/investor.lilly.com\/news-releases\/news-release-details\/lillys-surmount-1-results-published-new-england-journal-medicine\"><span style=\"text-decoration:underline\">SURMOUNT-1 trial<\/span><\/a>, participants taking the 15mg dose lost an average of 22.5% of their body weight after 72 weeks.<\/p>"
          }
        }
      },
