        "short_description_48fMMW": {
          "type": "short_description",
          "settings": {
            "text": "A prescription-only medication that effectively targets weight loss. Used weekly, Mounjaro works by slowing down digestion, reducing your appetite and helping you feel fuller for longer.<strong> <\/strong>"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
