        "short_description_48fMMW": {
          "type": "short_description",
          "settings": {
            "text": "A prescription-only medication that effectively targets weight loss. Used weekly, the active ingredient in Wegovy (semaglutide) mimics the hormone GLP-1** and works by reducing cravings and helping you feel fuller for longer.<strong> <\/strong>"
          }
        },
        "buy_buttons": {
