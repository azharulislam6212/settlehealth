          "type": "collapsible_row",
          "settings": {
            "content_tab_id": "most",
            "heading": "How quickly can I be seen?",
            "row_content": "<p>You can usually book an assessment within a few days, depending on clinician availability. <br/><br/>Once your appointment is confirmed, you’ll complete any required forms online before meeting with a specialist clinician for your assessment.</p>"
          }
        },
