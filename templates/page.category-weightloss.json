    "team_carousel_product_fPwkMj": {
      "type": "team-carousel-product",
      "blocks": {
        "team_block_WbNpwM": {
          "type": "team_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "Blown away",
            "designation": "",
            "text": "\"I was blown away by the attention to detail and care from the settlehealth team. I have discussed in depth the benefits of their weight-loss medication and how it can help me. The team supported me from beginning to end and continue to be on hand with all my questions. I’ve been using the product for 2 months and I can’t believe how much it’s positively impacted my life.\" <em>Lauren<\/em>",
            "button_label": "",
            "button_link": ""
          }
        },
        "team_block_6hHFhP": {
          "type": "team_block",
          "disabled": true,
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "",
            "designation": "",
            "text": "\"All my family and friends comment on how well I am looking. settlehealth consistently cost me less than all the other providers, not just the first order like most companies do as an incentive to join them, but with every order. They send out my orders quickly, and they come chilled every time.\"",
            "button_label": "",
            "button_link": ""
          }
        },
        "team_block_BrJEyz": {
          "type": "team_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "100% recommend",
            "designation": "",
            "text": "\"I’ve been ordering weight-loss medication from settlehealth monthly for over 12 months. I’ve never experienced any problems at all. I have contacted a couple of times to speak to a prescriber for advice around maintenance dosing and have always found them informative and extremely helpful. 100% recommend.\" <em>Anonymous <\/em>",
            "button_label": "",
            "button_link": ""
          }
        },
        "team_block_tfX9A3": {
          "type": "team_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "settlehealth is the best",
            "designation": "",
            "text": "\"I highly recommend settlehealth for weight management! They provide all the updates you need to stay on track, and their support team is fantastic at replying to emails quickly. I was also really impressed by how fast they approved and posted my prescription.\" <em>EMO<\/em>",
            "button_label": "",
            "button_link": ""
          }
        },
        "team_block_hKj7Re": {
          "type": "team_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "Very looked after",
            "designation": "",
            "text": "\"I feel I am looked after. Although everything is very efficient, it is also thorough in making sure the product is right for you and continues to be right for you. I have lost 20lbs in 10 weeks on Mounjaro, which feels sensible and not too dramatic. I’m learning lots about me and food on the journey.\" <em>Ms C<\/em>",
            "button_label": "",
            "button_link": ""
          }
        },
        "team_block_bEbrqD": {
          "type": "team_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/stars.jpg",
            "name": "The process was very easy",
            "designation": "",
            "text": "\"The process was very easy - all information was emailed to me with instructions. The video call was straightforward. I received my first package quickly after this. Ordering is easy and delivery is fast, usually next day. When the item is delivered, it is in a good strong padded bag with an ice pack, so if I'm not home to receive the parcel, its not a problem.\" <em>Teresa<\/em>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
