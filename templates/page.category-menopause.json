      "type": "card-blocks",
      "blocks": {
        "card_block_JdPzMU": {
          "type": "card_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Estradoil_Box_1.png",
            "title": "Evorel HRT Patches",
            "text": "<p>Transdermal HRT (Hormone Replacement Treatment) patches are an effective treatment for menopause symptoms. A steady dose of oestrogen is absorbed into the skin to help regulate hormone levels.<\/p>",
