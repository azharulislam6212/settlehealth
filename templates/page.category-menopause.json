        },
        "card_block_qLAgnA": {
          "type": "card_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Estradoil_Box_1.png",
            "title": "Ovestin Vaginal Cream",
            "text": "<p>A soothing cream that relieves post- menopause symptoms such as vaginal dryness, soreness, itching, burning and pain during sex. The active ingredient estriol is a naturally occurring form of oestrogen that helps restore vaginal tissues. <\/p>",
