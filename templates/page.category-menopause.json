          }
        },
        "card_block_RjnY4Q": {
          "type": "card_block",
          "settings": {
            "image": "shopify:\/\/shop_images\/Estradoil_Box_1.png",
            "title": "Utrogestan Vaginal Capsules",
            "text": "<p>Designed to protect the lining of the womb if you haven’t had a hysterectomy, this vaginal capsule contains the female hormone progesterone. Taking oestrogen as part of HRT can cause the lining of the womb to thicken, and Utrogestan balances this to keep the lining healthy.<\/p>",
            "badge_text_left": "Popular",
