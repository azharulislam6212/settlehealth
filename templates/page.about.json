    "image_with_list_reverse_text_8CNGkE": {
      "type": "image-with-list-reverse-text",
      "blocks": {
        "heading_VXB3xg": {
          "type": "heading",
          "settings": {
            "heading": "A message from our Superintendent Pharmacist",
            "heading_size": "h1"
          }
        },
        "text_GAM7Qq": {
          "type": "text",
          "settings": {
            "text": "<p>“We’re here to help you feel healthier and more confident. This goes beyond medication. Our personalised, one-to-one care is designed for lasting change. And our team of clinicians supports you through every step, keeping you motivated and on track.”<\/p>",
            "text_style": "body"
          }
        },
